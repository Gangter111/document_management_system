<Window x:Class="DocumentManagement.Wpf.Views.ConfirmDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Style="{StaticResource DenseDialogWindowStyle}"
        ShowInTaskbar="False">

    <Border Style="{StaticResource DenseDialogRootCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource DenseDialogHeaderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconBackground" Style="{StaticResource DenseDialogIconBackgroundStyle}">
                        <TextBlock x:Name="IconText"
                                   Text="!"
                                   Style="{StaticResource DenseDialogIconTextStyle}"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Style="{StaticResource DenseDialogTitleStackStyle}">
                        <TextBlock x:Name="TitleTextBlock"
                                   Text="Xác nhận"
                                   Style="{StaticResource DenseDialogTitleTextStyle}"/>
                        <TextBlock Text="Vui lòng kiểm tra kỹ trước khi tiếp tục."
                                   Style="{StaticResource DenseDialogSubtitleTextStyle}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="×"
                            Style="{StaticResource DenseDialogCloseButtonStyle}"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource DenseDialogBodyStyle}">
                <TextBlock x:Name="MessageTextBlock"
                           Style="{StaticResource DenseDialogMessageTextStyle}"/>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource DenseDialogFooterStyle}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Style="{StaticResource DenseDialogCancelButtonStyle}"
                            IsCancel="True"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ConfirmButton"
                            Style="{StaticResource DenseDialogConfirmButtonStyle}"
                            IsDefault="True"
                            Click="ConfirmButton_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
