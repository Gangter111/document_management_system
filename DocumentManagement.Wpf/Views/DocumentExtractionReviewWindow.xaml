<Window x:Class="DocumentManagement.Wpf.Views.DocumentExtractionReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DocumentManagement.Wpf.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Document Intelligence Review"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource FluentCanvasBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <DataTemplate x:Key="CandidateEvidenceDetailsTemplate">
            <Border Margin="8,4,8,10"
                    Padding="10"
                    BorderBrush="{StaticResource FluentBorderBrush}"
                    BorderThickness="1"
                    Background="#F8FAFC">
                <StackPanel>
                    <TextBlock Text="Decision reasoning"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding ReasoningItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{Binding CategoryBackgroundBrush}"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            Padding="6,3"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Category}"
                                                   Foreground="{Binding CategoryBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               Foreground="#334155"
                                               Margin="0,2,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Confidence breakdown"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding ConfidenceItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="#334155"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ValueText}"
                                               Foreground="{Binding ValueBrush}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Explanation}"
                                               TextWrapping="Wrap"
                                               Foreground="#64748B"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Evidence provenance"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               Margin="0,8,0,8"/>
                    <ItemsControl ItemsSource="{Binding EvidenceItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="8"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        Background="White">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{Binding RoleBackgroundBrush}"
                                                BorderBrush="#CBD5E1"
                                                BorderThickness="1"
                                                Padding="7,3"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Role}"
                                                       Foreground="{Binding RoleBrush}"
                                                       FontWeight="{Binding FontWeight}"/>
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding RawText, StringFormat=Raw OCR: {0}}"
                                                       TextWrapping="Wrap"
                                                       FontWeight="{Binding FontWeight}"
                                                       Foreground="#0F172A"/>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding NormalizedText, StringFormat=Normalized: {0}}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Foreground="#334155"/>
                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding ExtractionSource, StringFormat=Extraction: {0}}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Foreground="#475569"/>
                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding RejectSource, StringFormat=Reject: {0}}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Foreground="#475569"/>
                                            <TextBlock Grid.Row="4"
                                                       Text="{Binding SourceRegion, StringFormat=Region: {0}}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0"
                                                       Foreground="#64748B"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Semantic Extraction Review"
                           Style="{StaticResource FluentTitleTextStyle}"
                           FontSize="20"/>
                <TextBlock Text="{Binding SelectedFilePath}"
                           Margin="0,4,0,0"
                           Style="{StaticResource FluentMutedTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="720"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding OpenFileCommand}"
                        Width="148"
                        Height="34"
                        Style="{StaticResource SecondaryButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileSearchOutline"
                                                 Style="{StaticResource ShellIconStyle}"/>
                        <TextBlock Text="Open JSON"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Close"
                        Width="92"
                        Height="34"
                        Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFeatureEnabled}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <TabControl>
                <TabItem Header="Fields">
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid ItemsSource="{Binding Fields}"
                                  SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Style="{StaticResource AppDataGridStyle}"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="150"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                <DataGridTemplateColumn Header="Confidence" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ConfidenceBackgroundBrush}"
                                                    BorderBrush="{Binding ConfidenceBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding ConfidencePercent}"
                                                           Foreground="{Binding ConfidenceBrush}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                <DataGridTextColumn Header="Page" Binding="{Binding PageIndex}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="2"
                                Style="{StaticResource AppCardStyle}"
                                Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left"
                                               Text="Source preview"
                                               Style="{StaticResource SectionTitleTextStyle}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <Button Command="{Binding PreviousPageCommand}"
                                                Width="32"
                                                Height="30"
                                                Padding="0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Previous page">
                                            <materialDesign:PackIcon Kind="ChevronLeft"
                                                                     Width="18"
                                                                     Height="18"/>
                                        </Button>
                                        <TextBlock Text="{Binding PageDisplayText}"
                                                   MinWidth="92"
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource FluentMutedTextStyle}"/>
                                        <Button Command="{Binding NextPageCommand}"
                                                Width="32"
                                                Height="30"
                                                Padding="0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                ToolTip="Next page">
                                            <materialDesign:PackIcon Kind="ChevronRight"
                                                                     Width="18"
                                                                     Height="18"/>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <WrapPanel>
                                        <CheckBox Content="Accepted"
                                                  IsChecked="{Binding ShowAcceptedOverlays}"
                                                  Margin="0,0,12,6"/>
                                        <CheckBox Content="Rejected"
                                                  IsChecked="{Binding ShowRejectedOverlays}"
                                                  Margin="0,0,12,6"/>
                                        <CheckBox Content="Low confidence only"
                                                  IsChecked="{Binding ShowLowConfidenceOnly}"
                                                  Margin="0,0,12,6"/>
                                        <CheckBox Content="Debug"
                                                  IsChecked="{Binding IsDebugOverlayEnabled}"
                                                  Margin="0,0,12,6"/>
                                    </WrapPanel>

                                    <Border Grid.Row="2"
                                            BorderBrush="{StaticResource FluentBorderBrush}"
                                            BorderThickness="1"
                                            Background="#F8FAFC"
                                            ClipToBounds="True">
                                        <controls:DocumentReviewOverlayCanvas x:Name="OverlayCanvas"
                                                                              PageOverlay="{Binding CurrentPageOverlay}"
                                                                              ActiveRegionId="{Binding ActiveOverlayRegionId}"
                                                                              ActiveSemanticGroupId="{Binding ActiveSemanticGroupId}"
                                                                              ShowAccepted="{Binding ShowAcceptedOverlays}"
                                                                              ShowRejected="{Binding ShowRejectedOverlays}"
                                                                              ShowLowConfidenceOnly="{Binding ShowLowConfidenceOnly}"
                                                                              IsDebugOverlayEnabled="{Binding IsDebugOverlayEnabled}"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Candidates">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource AppCardStyle}" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Accepted candidates"
                                           Style="{StaticResource SectionTitleTextStyle}"
                                           Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding AcceptedCandidates}"
                                          SelectedItem="{Binding SelectedAcceptedCandidate, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowDetailsVisibilityMode="VisibleWhenSelected"
                                          RowDetailsTemplate="{StaticResource CandidateEvidenceDetailsTemplate}"
                                          Style="{StaticResource AppDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="140"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidencePercent}" Width="100"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding SourceText}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource AppCardStyle}" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Rejected candidates"
                                           Style="{StaticResource SectionTitleTextStyle}"
                                           Margin="0,0,0,8"/>
                                <DataGrid ItemsSource="{Binding RejectedCandidates}"
                                          SelectedItem="{Binding SelectedRejectedCandidate, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          RowDetailsVisibilityMode="VisibleWhenSelected"
                                          RowDetailsTemplate="{StaticResource CandidateEvidenceDetailsTemplate}"
                                          Style="{StaticResource AppDataGridStyle}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="140"/>
                                        <DataGridTextColumn Header="Candidate" Binding="{Binding Value}" Width="180"/>
                                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidencePercent}" Width="100"/>
                                        <DataGridTextColumn Header="Reject reason" Binding="{Binding RejectReasons}" Width="*"/>
                                        <DataGridTextColumn Header="Evidence" Binding="{Binding SourceText}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Debug">
                    <Grid Margin="0,12,0,0">
                        <TextBox Text="{Binding DebugReport}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="{StaticResource FluentMonoFontFamily}"
                                 FontSize="12"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2"
                Background="#FEF3C7"
                BorderBrush="#F59E0B"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius8}"
                Padding="16"
                VerticalAlignment="Top">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFeatureEnabled}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock Text="Intelligence review is disabled"
                           FontWeight="SemiBold"
                           Foreground="#92400E"/>
                <TextBlock Text="Set Features:IntelligenceReviewEnabled to true to enable this isolated human-review screen."
                           Margin="0,6,0,0"
                           TextWrapping="Wrap"
                           Foreground="#92400E"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
