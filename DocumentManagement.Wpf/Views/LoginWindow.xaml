<Window x:Class="DocumentManagement.Wpf.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Đăng nhập hệ thống"
        Height="720"
        Width="1120"
        MinHeight="720"
        MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        Style="{StaticResource DenseLoginWindowStyle}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Grid Style="{StaticResource DenseLoginRootGridStyle}">
        <Grid Style="{StaticResource DenseLoginDragBarStyle}"
              MouseLeftButtonDown="TitleDragArea_MouseLeftButtonDown">
            <Button Style="{StaticResource DenseLoginCloseButtonStyle}"
                    Click="ExitButton_Click">
                <materialDesign:PackIcon Kind="Close"
                                         Width="17"
                                         Height="17"
                                         VerticalAlignment="Center"
                                         Foreground="{StaticResource DenseMutedBrush}"/>
            </Button>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="126"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
            </Grid.RowDefinitions>

            <Image Grid.Row="0"
                   Source="pack://application:,,,/Assets/Images/logo-tach.png"
                   Style="{StaticResource DenseLoginLogoImageStyle}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"/>

            <Border Grid.Row="1" Style="{StaticResource DenseLoginCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                        <TextBlock Text="LOGIN" Style="{StaticResource DenseLoginTitleTextStyle}"/>
                        <TextBlock Text="HỆ THỐNG QUẢN LÝ VĂN BẢN" Style="{StaticResource DenseLoginSubtitleTextStyle}"/>
                        <TextBlock x:Name="ServerUrlText" Style="{StaticResource DenseLoginServerTextStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="Email" Style="{StaticResource DenseLoginLabelTextStyle}"/>

                    <Grid Grid.Row="4">
                        <TextBox x:Name="UsernameTextBox"
                                 Style="{StaticResource LoginInputTextBoxStyle}"
                                 ToolTip="Nhập email hoặc tên đăng nhập"/>
                        <materialDesign:PackIcon Kind="EmailOutline" Style="{StaticResource DenseInputIconStyle}"/>
                        <TextBlock Text="Nhập email của bạn">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DenseLoginPlaceholderTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=UsernameTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Grid.Row="6" Text="Password" Style="{StaticResource DenseLoginLabelTextStyle}"/>

                    <Grid Grid.Row="8">
                        <TextBox x:Name="VisiblePasswordTextBox"
                                 Style="{StaticResource DenseLoginVisiblePasswordTextBoxStyle}"
                                 Visibility="Collapsed"
                                 TextChanged="VisiblePasswordTextBox_TextChanged"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource LoginPasswordBoxStyle}"
                                     PasswordChanged="PasswordBox_PasswordChanged"/>
                        <materialDesign:PackIcon Kind="LockOutline" Style="{StaticResource DenseInputIconStyle}"/>
                        <TextBlock x:Name="PasswordPlaceholder"
                                   Text="Nhập mật khẩu của bạn"
                                   Style="{StaticResource DenseLoginPlaceholderTextStyle}"/>
                        <Button x:Name="TogglePasswordButton"
                                Style="{StaticResource LoginIconButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Click="TogglePasswordVisibility_Click">
                            <materialDesign:PackIcon x:Name="TogglePasswordIcon"
                                                     Kind="EyeOutline"
                                                     Style="{StaticResource DenseShellTopIconStyle}"/>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Grid.Row="10" Style="{StaticResource DenseLoginErrorTextStyle}"/>

                    <Button Grid.Row="12"
                            Style="{StaticResource LoginPrimaryButtonStyle}"
                            Click="LoginButton_Click"
                            Content="ĐĂNG NHẬP"/>

                    <StackPanel Grid.Row="14"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostLinkButtonStyle}" Content="Quên mật khẩu?"/>
                        <Border Style="{StaticResource DenseVerticalDividerStyle}"/>
                        <Button Style="{StaticResource GhostLinkButtonStyle}" Content="Đăng ký tài khoản"/>
                        <Border Style="{StaticResource DenseVerticalDividerStyle}"/>
                        <Button Style="{StaticResource GhostLinkButtonStyle}"
                                Click="ServerSettingsButton_Click"
                                Content="Máy chủ"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="FileSearchOutline" Style="{StaticResource DenseShellSearchIconStyle}"/>
                <TextBlock Text="Tra cứu nhanh - Dữ liệu tập trung - Quản lý hiệu lực"
                           Style="{StaticResource DenseLoginFooterTextStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
