<UserControl x:Class="DocumentManagement.Wpf.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource DenseDocumentListRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource DenseHeaderBarStyle}">
            <Grid Style="{StaticResource DenseHeaderContentGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="HỆ THỐNG" Style="{StaticResource DenseHeaderTitleTextStyle}"/>
                    <Border Style="{StaticResource DenseVerticalDividerStyle}"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource DenseHeaderSubtitleTextStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Style="{StaticResource DenseDocumentToolbarStackStyle}">
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource DenseToolbarButtonStyle}">
                        <StackPanel Style="{StaticResource DenseInlineIconTextStackStyle}">
                            <materialDesign:PackIcon Kind="Refresh" Style="{StaticResource DenseAccentButtonIconStyle}"/>
                            <TextBlock Text="Làm mới" Style="{StaticResource DenseButtonTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="0.85*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource DenseTablePanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource DenseFilterTextBoxStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tìm người dùng..."/>
                        <Button Grid.Column="2" Command="{Binding SearchCommand}" Style="{StaticResource DenseToolbarButtonStyle}" Content="Tìm"/>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Style="{StaticResource DenseDocumentDataGridStyle}" AutoGenerateColumns="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="130" ElementStyle="{StaticResource DenseGridMutedTextStyle}"/>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*" ElementStyle="{StaticResource DenseGridTextStyle}"/>
                            <DataGridTextColumn Header="Phòng ban" Binding="{Binding Department}" Width="150" ElementStyle="{StaticResource DenseGridMutedTextStyle}"/>
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleName}" Width="100" ElementStyle="{StaticResource DenseGridMutedTextStyle}"/>
                            <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource DenseTablePanelStyle}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Người dùng" Style="{StaticResource DensePanelTitleTextStyle}"/>
                    <TextBox Grid.Row="2" Style="{StaticResource DenseFilterTextBoxStyle}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Tên đăng nhập"/>
                    <TextBox Grid.Row="4" Style="{StaticResource DenseFilterTextBoxStyle}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Họ tên"/>
                    <TextBox Grid.Row="6" Style="{StaticResource DenseFilterTextBoxStyle}" Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Phòng ban"/>
                    <TextBox Grid.Row="8" Style="{StaticResource DenseFilterTextBoxStyle}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Mật khẩu mới"/>
                    <ComboBox Grid.Row="10" Style="{StaticResource DenseFilterComboBoxStyle}" ItemsSource="{Binding Roles}" SelectedValue="{Binding RoleId}" DisplayMemberPath="Name" SelectedValuePath="Id" materialDesign:HintAssist.Hint="Vai trò"/>
                    <CheckBox Grid.Row="12" Content="Hoạt động" IsChecked="{Binding IsActive}" VerticalAlignment="Center"/>

                    <StackPanel Grid.Row="14" Style="{StaticResource DenseDocumentToolbarStackStyle}">
                        <Button Command="{Binding NewUserCommand}" Style="{StaticResource DenseToolbarButtonStyle}" Content="Mới"/>
                        <Button Command="{Binding SaveUserCommand}" Style="{StaticResource DenseToolbarButtonStyle}" Content="Lưu" Visibility="{Binding CanManageSystem, Converter={StaticResource BoolToVisibility}}"/>
                        <Button Command="{Binding DeleteUserCommand}" Style="{StaticResource DenseToolbarButtonStyle}" Content="Ngưng kích hoạt" Visibility="{Binding CanManageSystem, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.RowSpan="2" Style="{StaticResource LoadingOverlayGridStyle}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource LoadingCardStyle}">
                <StackPanel Style="{StaticResource DenseCenteredStateStackStyle}">
                    <ProgressBar Style="{StaticResource DenseLoadingProgressBarStyle}" IsIndeterminate="True"/>
                    <TextBlock Text="Đang tải cấu hình..." Style="{StaticResource LoadingTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
