<UserControl x:Class="DocumentManagement.Wpf.Views.DashboardView"
             x:Name="DashboardRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:DocumentManagement.Wpf.Controls"
             xmlns:conv="clr-namespace:DocumentManagement.Wpf.Converters"
             Background="#F8FAFC"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:StatusNameToBrushConverter x:Key="StatusNameToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <SolidColorBrush x:Key="DashboardGreen" Color="#2FA52C"/>
        <SolidColorBrush x:Key="DashboardGreenDark" Color="#168333"/>
        <SolidColorBrush x:Key="DashboardGreenSoft" Color="#EEF8EC"/>
        <SolidColorBrush x:Key="DashboardBorder" Color="#9BB3A6"/>
        <SolidColorBrush x:Key="DashboardBorderSoft" Color="#C6D6CD"/>
        <SolidColorBrush x:Key="DashboardHeaderBorder" Color="#0E6828"/>
        <SolidColorBrush x:Key="DashboardGridLine" Color="#D9ECDD"/>
        <SolidColorBrush x:Key="DashboardPanelTitleBrush" Color="#08224C"/>
        <SolidColorBrush x:Key="DashboardPanelLabelBrush" Color="#0A2A55"/>
        <SolidColorBrush x:Key="DashboardPanelSubtleTextBrush" Color="#46698B"/>

        <Style x:Key="DashboardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource DashboardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DashboardPanelTitleBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ChartPanelHeaderStyle" TargetType="Border">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F7FAF8"/>
            <Setter Property="BorderBrush" Value="{StaticResource DashboardBorderSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,0,8,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ChartPanelTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#2B2F2D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DashboardChartIconButtonStyle" TargetType="Button" BasedOn="{StaticResource FluentIconButtonStyle}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCEBF6"/>
            <Setter Property="Foreground" Value="#25567E"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="ToolTip" Value="Làm mới dữ liệu biểu đồ"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#8FAFCB"
                                                  BlurRadius="10"
                                                  ShadowDepth="2"
                                                  Opacity="0.16"
                                                  RenderingBias="Performance"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#BFD7EE"/>
                                <Setter TargetName="Root" Property="Background" Value="#F8FCFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF7FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="DashboardChartCardShadow"
                          Color="#8FAFCB"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Opacity="0.16"
                          RenderingBias="Performance"/>

        <LinearGradientBrush x:Key="DashboardPremiumChartCardBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#FBFDFF" Offset="0.58"/>
            <GradientStop Color="#F2F8FE" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DashboardPremiumIconBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#5BE8FF" Offset="0"/>
            <GradientStop Color="#0B7AF4" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DashboardKpiGreenBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#58E0A3" Offset="0"/>
            <GradientStop Color="#18B978" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DashboardKpiPurpleBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#B86AF5" Offset="0"/>
            <GradientStop Color="#5E39E6" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DashboardKpiOrangeBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFB057" Offset="0"/>
            <GradientStop Color="#FF7B24" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="DashboardPremiumChartPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource DashboardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="DashboardPremiumChartTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DashboardPanelTitleBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DashboardPremiumLegendTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DashboardPanelLabelBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="DashboardChartKpiPanelStyle" TargetType="Border">
            <Setter Property="Height" Value="68"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="Background" Value="#FBFDFF"/>
            <Setter Property="BorderBrush" Value="#DCEBF6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="8,7"/>
        </Style>

        <Style x:Key="DashboardChartKpiLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DashboardPanelSubtleTextBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DashboardChartKpiValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0B7AF4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DashboardChartKpiSubtleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DashboardPanelSubtleTextBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="DashboardChartKpiIconStyle" TargetType="Border">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MetricBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="94"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#FFFFFC"/>
            <Setter Property="BorderBrush" Value="{StaticResource DashboardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#244238"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DashboardGreenDark}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="{StaticResource DashboardPanelLabelBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="GridMutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
            <Setter Property="Foreground" Value="{StaticResource DashboardPanelSubtleTextBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Margin="14"
                Background="#FFFFFC"
                BorderBrush="{StaticResource DashboardBorder}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="146"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource MetricBoxStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TỔNG VĂN BẢN" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding TotalDocuments, StringFormat={}{0:N0}}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricBoxStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ĐÃ BAN HÀNH" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding IssuedDocuments, StringFormat={}{0:N0}}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricBoxStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CÒN HIỆU LỰC" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding EffectiveDocuments, StringFormat={}{0:N0}}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricBoxStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HẾT HIỆU LỰC" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding ExpiredDocuments, StringFormat={}{0:N0}}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricBoxStyle}" Height="112">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="TB BAN HÀNH / THÁNG" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock Text="{Binding AverageIssuedPerMonth, StringFormat={}{0:N1}}" Style="{StaticResource MetricValueStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border Background="{StaticResource DashboardGreen}"
                                BorderBrush="{StaticResource DashboardHeaderBorder}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <TextBlock Text="TỔNG QUAN VĂN BẢN"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Border Width="118"
                                Height="34"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0"
                                Background="#FFFFFC"
                                BorderBrush="#8FB39C"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="8,3">
                            <Image Source="pack://application:,,,/Assets/Images/logo-tach.png"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.08*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="2"
                                Grid.Column="2"
                                Style="{StaticResource DashboardPremiumChartPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="74"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="9"
                                            Background="#FFFFFF"
                                            BorderBrush="#DCEBF6"
                                            BorderThickness="1"
                                            VerticalAlignment="Top">
                                        <Grid Margin="7">
                                            <Rectangle Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="#2E8DF7" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="#4AC8F8" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="4" Height="22" RadiusX="2" RadiusY="2" Fill="#0B7AF4" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Văn bản ban hành theo tháng"
                                                   Style="{StaticResource DashboardPremiumChartTitleStyle}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,4,0,0">
                                            <Ellipse Width="10"
                                                     Height="10"
                                                     Fill="{StaticResource DashboardPremiumIconBrush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="Văn bản ban hành"
                                                       Style="{StaticResource DashboardPremiumLegendTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <Button Style="{StaticResource DashboardChartIconButtonStyle}"
                                                IsEnabled="False"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Bộ chọn kỳ dữ liệu riêng cho biểu đồ tháng chưa được cấu hình.">
                                            <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="15" Height="15" Foreground="#18BFA5"/>
                                        </Button>
                                        <Button Style="{StaticResource DashboardChartIconButtonStyle}"
                                                IsEnabled="False"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Bộ lọc riêng cho biểu đồ tháng chưa được cấu hình.">
                                            <materialDesign:PackIcon Kind="FilterVariant" Width="15" Height="15"/>
                                        </Button>
                                        <Button Style="{StaticResource DashboardChartIconButtonStyle}"
                                                IsEnabled="False"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Menu thao tác riêng cho biểu đồ tháng chưa được cấu hình.">
                                            <materialDesign:PackIcon Kind="DotsHorizontal" Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <controls:MonthlyIssuedTimelineChart Grid.Row="1"
                                                                     ItemsSource="{Binding MonthlyIssuedItems}"
                                                                     Margin="0,2,0,0"/>

                                <Border Grid.Row="2" Style="{StaticResource DashboardChartKpiPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="1" Fill="#D8E6F1"/>
                                        <Rectangle Grid.Column="3" Fill="#D8E6F1"/>
                                        <Rectangle Grid.Column="5" Fill="#D8E6F1"/>

                                        <Grid Grid.Column="0" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DashboardChartKpiIconStyle}" Background="{StaticResource DashboardPremiumIconBrush}">
                                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Tổng văn bản" Style="{StaticResource DashboardChartKpiLabelStyle}"/>
                                                <TextBlock Text="{Binding MonthlyIssuedTotal, StringFormat={}{0:N0}}" Style="{StaticResource DashboardChartKpiValueStyle}"/>
                                                <TextBlock Text="{Binding MonthlyIssuedPeriodCount, StringFormat=Trong {0:N0} tháng}" Style="{StaticResource DashboardChartKpiSubtleStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Column="2" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DashboardChartKpiIconStyle}" Background="{StaticResource DashboardKpiGreenBrush}">
                                                <materialDesign:PackIcon Kind="TrendingUp" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Trung bình / tháng" Style="{StaticResource DashboardChartKpiLabelStyle}"/>
                                                <TextBlock Text="{Binding MonthlyIssuedAverage, StringFormat={}{0:N2}}" Foreground="#21B97E" Style="{StaticResource DashboardChartKpiValueStyle}"/>
                                                <TextBlock Text="Văn bản" Style="{StaticResource DashboardChartKpiSubtleStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Column="4" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DashboardChartKpiIconStyle}" Background="{StaticResource DashboardKpiPurpleBrush}">
                                                <materialDesign:PackIcon Kind="ChartLine" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Cao nhất" Style="{StaticResource DashboardChartKpiLabelStyle}"/>
                                                <TextBlock Text="{Binding MonthlyIssuedHighest, StringFormat={}{0:N0}}" Foreground="#7C4BEF" Style="{StaticResource DashboardChartKpiValueStyle}"/>
                                                <TextBlock Text="Văn bản" Style="{StaticResource DashboardChartKpiSubtleStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Column="6" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DashboardChartKpiIconStyle}" Background="{StaticResource DashboardKpiOrangeBrush}">
                                                <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Tháng cao nhất" Style="{StaticResource DashboardChartKpiLabelStyle}"/>
                                                <TextBlock Text="{Binding MonthlyIssuedHighestPeriod}" Foreground="#FF8833" Style="{StaticResource DashboardChartKpiValueStyle}"/>
                                                <TextBlock Text="Theo dữ liệu thực" Style="{StaticResource DashboardChartKpiSubtleStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Style="{StaticResource DashboardPremiumChartPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="74"/>
                                </Grid.RowDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="9"
                                            Background="#FFFFFF"
                                            BorderBrush="#DCEBF6"
                                            BorderThickness="1"
                                            VerticalAlignment="Top">
                                        <Grid Margin="7">
                                            <Rectangle Width="4" Height="10" RadiusX="2" RadiusY="2" Fill="#2E8DF7" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="#4AC8F8" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                            <Rectangle Width="4" Height="22" RadiusX="2" RadiusY="2" Fill="#20BFEA" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="Văn bản theo phòng ban"
                                                   Style="{StaticResource DashboardPremiumChartTitleStyle}"/>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,4,0,0">
                                            <Ellipse Width="10"
                                                     Height="10"
                                                     Fill="{StaticResource DashboardPremiumIconBrush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="Văn bản phát hành"
                                                       Style="{StaticResource DashboardPremiumLegendTextStyle}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <Button Style="{StaticResource DashboardChartIconButtonStyle}"
                                                IsEnabled="False"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Bộ chọn kỳ dữ liệu riêng cho biểu đồ phòng ban chưa được cấu hình.">
                                            <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="15" Height="15" Foreground="#18BFA5"/>
                                        </Button>
                                        <Button Style="{StaticResource DashboardChartIconButtonStyle}"
                                                IsEnabled="False"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Bộ lọc riêng cho biểu đồ phòng ban chưa được cấu hình.">
                                            <materialDesign:PackIcon Kind="FilterVariant" Width="15" Height="15"/>
                                        </Button>
                                        <Button Style="{StaticResource DashboardChartIconButtonStyle}"
                                                IsEnabled="False"
                                                ToolTipService.ShowOnDisabled="True"
                                                ToolTip="Menu thao tác riêng cho biểu đồ phòng ban chưa được cấu hình.">
                                            <materialDesign:PackIcon Kind="DotsHorizontal" Width="15" Height="15"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <controls:DepartmentDocuments3DChart Grid.Row="1"
                                                                     ItemsSource="{Binding DepartmentIssuedItems}"
                                                                     Margin="0,2,0,0"/>

                                <Border Grid.Row="2" Style="{StaticResource DashboardChartKpiPanelStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Grid.Column="1" Fill="#D8E6F1"/>
                                        <Rectangle Grid.Column="3" Fill="#D8E6F1"/>
                                        <Rectangle Grid.Column="5" Fill="#D8E6F1"/>

                                        <Grid Grid.Column="0" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DashboardChartKpiIconStyle}" Background="{StaticResource DashboardPremiumIconBrush}">
                                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Tổng văn bản" Style="{StaticResource DashboardChartKpiLabelStyle}"/>
                                                <TextBlock Text="{Binding DepartmentIssuedTotal, StringFormat={}{0:N0}}" Style="{StaticResource DashboardChartKpiValueStyle}"/>
                                                <TextBlock Text="{Binding DepartmentIssuedCount, StringFormat=Trong {0:N0} phòng ban}" Style="{StaticResource DashboardChartKpiSubtleStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Column="2" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DashboardChartKpiIconStyle}" Background="{StaticResource DashboardKpiGreenBrush}">
                                                <materialDesign:PackIcon Kind="TrendingUp" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Trung bình / phòng" Style="{StaticResource DashboardChartKpiLabelStyle}"/>
                                                <TextBlock Text="{Binding DepartmentIssuedAverage, StringFormat={}{0:N2}}" Foreground="#21B97E" Style="{StaticResource DashboardChartKpiValueStyle}"/>
                                                <TextBlock Text="Văn bản" Style="{StaticResource DashboardChartKpiSubtleStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Column="4" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DashboardChartKpiIconStyle}" Background="{StaticResource DashboardKpiPurpleBrush}">
                                                <materialDesign:PackIcon Kind="ChartLine" Width="19" Height="19" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Cao nhất" Style="{StaticResource DashboardChartKpiLabelStyle}"/>
                                                <TextBlock Text="{Binding DepartmentIssuedHighest, StringFormat={}{0:N0}}" Foreground="#7C4BEF" Style="{StaticResource DashboardChartKpiValueStyle}"/>
                                                <TextBlock Text="Văn bản" Style="{StaticResource DashboardChartKpiSubtleStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Column="6" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource DashboardChartKpiIconStyle}" Background="{StaticResource DashboardKpiOrangeBrush}">
                                                <materialDesign:PackIcon Kind="OfficeBuildingOutline" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Phòng ban cao nhất" Style="{StaticResource DashboardChartKpiLabelStyle}"/>
                                                <TextBlock Text="{Binding DepartmentIssuedHighestDepartmentSummary}" Foreground="#08224C" Style="{StaticResource DashboardChartKpiValueStyle}"/>
                                                <TextBlock Text="{Binding DepartmentIssuedHighestValueText}" Style="{StaticResource DashboardChartKpiSubtleStyle}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Grid.Column="0"
                                Style="{StaticResource DashboardPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Văn bản mới ban hành" Style="{StaticResource PanelTitleStyle}"/>
                                <DataGrid x:Name="RecentDocumentsGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding RecentDocuments}"
                                          Style="{StaticResource AppDataGridStyle}"
                                          AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="None"
                                          RowHeaderWidth="0"
                                          RowHeight="38"
                                          ColumnHeaderHeight="34"
                                          MouseDoubleClick="RecentDocumentsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Số ký hiệu" Binding="{Binding DocumentNumber}" Width="116" ElementStyle="{StaticResource GridMutedTextStyle}"/>
                                        <DataGridTextColumn Header="Trích yếu" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource GridTextStyle}"/>
                                        <DataGridTextColumn Header="Ngày cập nhật" Binding="{Binding UpdatedAt, StringFormat=dd/MM}" Width="104" ElementStyle="{StaticResource GridMutedTextStyle}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0"
                                Grid.Column="0"
                                Style="{StaticResource DashboardPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Cơ cấu hiệu lực văn bản" Style="{StaticResource PanelTitleStyle}"/>
                                <Grid Grid.Row="1" Margin="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.48*"/>
                                        <ColumnDefinition Width="0.95*"/>
                                    </Grid.ColumnDefinitions>

                                    <Viewbox Stretch="Uniform"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Stretch"
                                             Margin="-10,-12,-4,-10">
                                        <controls:RadialDocumentChart Width="600"
                                                                      Height="600"
                                                                      TotalDocuments="{Binding TotalDocuments}"
                                                                      IssuedDocuments="{Binding IssuedDocuments}"
                                                                      EffectiveDocuments="{Binding EffectiveDocuments}"
                                                                      ExpiredDocuments="{Binding ExpiredDocuments}"
                                                                      HoveredMetric="{Binding HoveredChartMetric, ElementName=DashboardRoot, Mode=TwoWay}"
                                                                      SelectedMetric="{Binding SelectedMetric, Mode=TwoWay}"/>
                                    </Viewbox>

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="4,0,0,0">
                                        <controls:DashboardKpiCard Title="Tổng số"
                                                                   MetricKey="Total"
                                                                   HoveredMetric="{Binding HoveredChartMetric, ElementName=DashboardRoot, Mode=TwoWay}"
                                                                   SelectedMetric="{Binding SelectedMetric, Mode=TwoWay}"
                                                                   ValueText="100%"
                                                                   IconKind="Pie"
                                                                   AccentBrush="#94A3B8"
                                                                   ValueBrush="#64748B"/>

                                        <controls:DashboardKpiCard Title="Phát hành"
                                                                   MetricKey="Issued"
                                                                   HoveredMetric="{Binding HoveredChartMetric, ElementName=DashboardRoot, Mode=TwoWay}"
                                                                   SelectedMetric="{Binding SelectedMetric, Mode=TwoWay}"
                                                                   ValueText="{Binding IssuedPercentText}"
                                                                   IconKind="Send"
                                                                   AccentBrush="#2563EB"
                                                                   ValueBrush="#2563EB"
                                                                   Margin="0,8,0,0"/>

                                        <controls:DashboardKpiCard Title="Còn hiệu lực"
                                                                   MetricKey="Effective"
                                                                   HoveredMetric="{Binding HoveredChartMetric, ElementName=DashboardRoot, Mode=TwoWay}"
                                                                   SelectedMetric="{Binding SelectedMetric, Mode=TwoWay}"
                                                                   ValueText="{Binding EffectivePercentText}"
                                                                   IconKind="Shield"
                                                                   AccentBrush="#10B981"
                                                                   ValueBrush="#10B981"
                                                                   Margin="0,8,0,0"/>

                                        <controls:DashboardKpiCard Title="Hết hiệu lực"
                                                                   MetricKey="Expired"
                                                                   HoveredMetric="{Binding HoveredChartMetric, ElementName=DashboardRoot, Mode=TwoWay}"
                                                                   SelectedMetric="{Binding SelectedMetric, Mode=TwoWay}"
                                                                   ValueText="{Binding ExpiredPercentText}"
                                                                   IconKind="Expired"
                                                                   AccentBrush="#EF4444"
                                                                   ValueBrush="#EF4444"
                                                                   Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <Grid Style="{StaticResource LoadingOverlayGridStyle}"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource LoadingCardStyle}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="140" Height="6" IsIndeterminate="True" Margin="0,0,0,18"/>
                    <TextBlock Text="Đang tải dashboard..." Style="{StaticResource LoadingTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource ErrorBannerStyle}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerTextStyle}"/>
        </Border>
    </Grid>
</UserControl>
