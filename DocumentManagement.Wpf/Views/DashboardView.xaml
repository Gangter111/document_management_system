<UserControl x:Class="DocumentManagement.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:conv="clr-namespace:DocumentManagement.Wpf.Converters"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <conv:StatusNameToBrushConverter x:Key="StatusNameToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource DenseDashboardViewportStyle}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <Grid Style="{StaticResource DenseDashboardContentGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="260"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="230"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource DenseHeaderBarStyle}">
                    <Grid Style="{StaticResource DenseHeaderContentGridStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TỔNG QUAN VĂN BẢN"
                                       Style="{StaticResource DenseHeaderTitleTextStyle}"/>
                            <Border Style="{StaticResource DenseVerticalDividerStyle}"/>
                            <TextBlock Text="Phân tích vận hành, hiệu lực và luồng cập nhật"
                                       Style="{StaticResource DenseHeaderSubtitleTextStyle}"/>
                        </StackPanel>

                        <Border Grid.Column="2" Style="{StaticResource DenseLogoPillStyle}">
                            <Image Source="pack://application:,,,/Assets/Images/logo-tach.png"
                                   Style="{StaticResource DenseShellLogoImageStyle}"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DenseKpiCardStyle}">
                        <StackPanel Style="{StaticResource DenseKpiContentStackStyle}">
                            <TextBlock Text="TỔNG VĂN BẢN" Style="{StaticResource DenseKpiLabelTextStyle}"/>
                            <TextBlock Text="{Binding TotalDocuments, StringFormat={}{0:N0}}" Style="{StaticResource DenseKpiValueTextStyle}"/>
                            <TextBlock Text="Toàn bộ hồ sơ đang quản lý" Style="{StaticResource DenseKpiMetaTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DenseKpiCardStyle}">
                        <StackPanel Style="{StaticResource DenseKpiContentStackStyle}">
                            <TextBlock Text="ĐÃ BAN HÀNH" Style="{StaticResource DenseKpiLabelTextStyle}"/>
                            <TextBlock Text="{Binding IssuedDocuments, StringFormat={}{0:N0}}" Style="{StaticResource DenseKpiValueTextStyle}"/>
                            <TextBlock Text="Văn bản hoàn tất phát hành" Style="{StaticResource DenseKpiMetaTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource DenseKpiCardStyle}">
                        <StackPanel Style="{StaticResource DenseKpiContentStackStyle}">
                            <TextBlock Text="CÒN HIỆU LỰC" Style="{StaticResource DenseKpiLabelTextStyle}"/>
                            <TextBlock Text="{Binding EffectiveDocuments, StringFormat={}{0:N0}}" Style="{StaticResource DenseKpiValueTextStyle}"/>
                            <TextBlock Text="Đang áp dụng trong hệ thống" Style="{StaticResource DenseKpiMetaTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Style="{StaticResource DenseKpiCardStyle}">
                        <StackPanel Style="{StaticResource DenseKpiContentStackStyle}">
                            <TextBlock Text="HẾT HIỆU LỰC" Style="{StaticResource DenseKpiLabelTextStyle}"/>
                            <TextBlock Text="{Binding ExpiredDocuments, StringFormat={}{0:N0}}" Style="{StaticResource DenseKpiValueTextStyle}"/>
                            <TextBlock Text="Cần rà soát hoặc lưu trữ" Style="{StaticResource DenseKpiMetaTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="8" Style="{StaticResource DenseKpiCardStyle}">
                        <StackPanel Style="{StaticResource DenseKpiContentStackStyle}">
                            <TextBlock Text="TB / THÁNG" Style="{StaticResource DenseKpiLabelTextStyle}"/>
                            <TextBlock Text="{Binding AverageIssuedPerMonth, StringFormat={}{0:N1}}" Style="{StaticResource DenseKpiValueTextStyle}"/>
                            <TextBlock Text="Tốc độ phát hành trung bình" Style="{StaticResource DenseKpiMetaTextStyle}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.08*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DenseAnalyticsPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Văn bản ban hành theo tháng" Style="{StaticResource DensePanelTitleTextStyle}"/>
                            <lvc:CartesianChart Grid.Row="1"
                                                Style="{StaticResource DenseCartesianChartStyle}"
                                                Series="{Binding MonthlyIssuedSeries}"
                                                LegendLocation="Top">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding MonthlyIssuedLabels}" Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis MinValue="0"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DenseAnalyticsPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Văn bản theo phòng ban" Style="{StaticResource DensePanelTitleTextStyle}"/>
                            <lvc:CartesianChart Grid.Row="1"
                                                Style="{StaticResource DenseCartesianChartStyle}"
                                                Series="{Binding DepartmentIssuedSeries}"
                                                LegendLocation="None">
                                <lvc:CartesianChart.AxisX>
                                    <lvc:Axis Labels="{Binding DepartmentIssuedLabels}" Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                                </lvc:CartesianChart.AxisX>
                                <lvc:CartesianChart.AxisY>
                                    <lvc:Axis MinValue="0"/>
                                </lvc:CartesianChart.AxisY>
                            </lvc:CartesianChart>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.18*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="0.82*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DenseAnalyticsFeedPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Văn bản mới ban hành" Style="{StaticResource DensePanelTitleTextStyle}"/>
                            <DataGrid x:Name="RecentDocumentsGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding RecentDocuments}"
                                      Style="{StaticResource DenseDashboardFeedDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="None"
                                      RowHeaderWidth="0"
                                      RowHeight="32"
                                      ColumnHeaderHeight="30"
                                      MouseDoubleClick="RecentDocumentsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Số ký hiệu" Binding="{Binding DocumentNumber}" Width="106" ElementStyle="{StaticResource DenseGridMutedTextStyle}"/>
                                    <DataGridTextColumn Header="Trích yếu" Binding="{Binding Title}" Width="*" ElementStyle="{StaticResource DenseGridTextStyle}"/>
                                    <DataGridTextColumn Header="Cập nhật" Binding="{Binding UpdatedAt, StringFormat=dd/MM}" Width="78" ElementStyle="{StaticResource DenseGridMutedTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="1">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource EmptyStateContainerStyle}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRecentDocuments}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Style="{StaticResource DenseCenteredStateStackStyle}">
                                    <TextBlock Text="Chưa có cập nhật mới" Style="{StaticResource DenseEmptyStateTitleTextStyle}"/>
                                    <TextBlock Text="Các văn bản ban hành gần đây sẽ xuất hiện tại đây." Style="{StaticResource DenseEmptyStateDescriptionTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DenseAnalyticsFeedPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="31"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Cơ cấu hiệu lực văn bản" Style="{StaticResource DensePanelTitleTextStyle}"/>
                            <Grid Grid.Row="1" Style="{StaticResource DenseSectionGridStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="138"/>
                                </Grid.ColumnDefinitions>

                                <lvc:PieChart Series="{Binding EffectivenessSeries}"
                                              Style="{StaticResource DensePieChartStyle}"/>

                                <StackPanel Grid.Column="1" Style="{StaticResource DenseSummaryStackStyle}">
                                    <TextBlock Text="Tổng văn bản" Style="{StaticResource DenseSummaryLabelTextStyle}"/>
                                    <TextBlock Text="{Binding TotalDocuments, StringFormat={}{0:N0}}" Style="{StaticResource DenseSummaryValueTextStyle}"/>
                                    <TextBlock Text="{Binding TopIssuingDepartment, StringFormat=Đơn vị nổi bật: {0}}" Style="{StaticResource DenseSummaryTextStyle}"/>
                                    <TextBlock Text="{Binding TopIssuingDepartmentCount, StringFormat={}{0:N0} văn bản}" Style="{StaticResource DenseSummaryLabelTextStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Grid Style="{StaticResource LoadingOverlayGridStyle}"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource LoadingCardStyle}">
                <StackPanel Style="{StaticResource DenseCenteredStateStackStyle}">
                    <ProgressBar Style="{StaticResource DenseLoadingProgressBarStyle}" IsIndeterminate="True"/>
                    <TextBlock Text="Đang tải dashboard..." Style="{StaticResource LoadingTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource ErrorBannerStyle}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerTextStyle}"/>
        </Border>
    </Grid>
</UserControl>
