<UserControl x:Class="DocumentManagement.Wpf.Views.DocumentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:DocumentManagement.Wpf.Converters">

    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Style="{StaticResource DenseDocumentListRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Style="{StaticResource DenseDocumentListHeaderGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="DANH SÁCH VĂN BẢN"
                           Style="{StaticResource DenseDocumentListTitleTextStyle}"/>

                <StackPanel Style="{StaticResource DenseDocumentToolbarStackStyle}">
                    <Button Command="{Binding AddCommand}"
                            Style="{StaticResource DenseToolbarDangerButtonStyle}"
                            Visibility="{Binding CanCreateDocument, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource DenseInlineIconTextStackStyle}">
                            <materialDesign:PackIcon Kind="Plus" Style="{StaticResource DenseButtonIconStyle}"/>
                            <TextBlock Text="Thêm văn bản" Style="{StaticResource DenseButtonTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportExcelCommand}"
                            Style="{StaticResource DenseToolbarButtonStyle}"
                            Visibility="{Binding CanExportExcel, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource DenseInlineIconTextStackStyle}">
                            <materialDesign:PackIcon Kind="FileExcelOutline" Style="{StaticResource DenseAccentButtonIconStyle}"/>
                            <TextBlock Text="Xuất Excel" Style="{StaticResource DenseButtonTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Style="{StaticResource DenseDocumentFilterGridStyle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource DenseFilterTextBoxStyle}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Tìm kiếm theo số ký hiệu, trích yếu..."
                         materialDesign:HintAssist.IsFloating="False"/>

                <ComboBox Grid.Column="2"
                          Style="{StaticResource DenseFilterComboBoxStyle}"
                          ItemsSource="{Binding Categories}"
                          SelectedValue="{Binding SelectedCategoryId}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          materialDesign:HintAssist.Hint="Loại văn bản"
                          materialDesign:HintAssist.IsFloating="False"/>

                <ComboBox Grid.Column="4"
                          Style="{StaticResource DenseFilterComboBoxStyle}"
                          ItemsSource="{Binding Statuses}"
                          SelectedValue="{Binding SelectedStatusId}"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          materialDesign:HintAssist.Hint="Trạng thái"
                          materialDesign:HintAssist.IsFloating="False"/>

                <ComboBox Grid.Column="6"
                          Style="{StaticResource DenseFilterComboBoxStyle}"
                          ItemsSource="{Binding UrgencyOptions}"
                          SelectedValue="{Binding SelectedUrgency}"
                          SelectedValuePath="Value"
                          DisplayMemberPath="Text"
                          materialDesign:HintAssist.Hint="Độ khẩn"
                          materialDesign:HintAssist.IsFloating="False"/>

                <Button Grid.Column="8"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource DenseToolbarButtonStyle}"
                        Content="Xóa lọc"/>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource DenseTablePanelStyle}">
            <Grid>
                <DataGrid x:Name="DocumentsDataGrid"
                          MouseDoubleClick="DocumentsDataGrid_MouseDoubleClick"
                          ItemsSource="{Binding Documents}"
                          SelectedItem="{Binding SelectedDocument}"
                          Style="{StaticResource DenseDocumentDataGridStyle}"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="None"
                          RowHeaderWidth="0"
                          RowHeight="38"
                          ColumnHeaderHeight="34"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Width="48" Binding="{Binding Id}" ElementStyle="{StaticResource DenseGridMutedTextStyle}"/>
                        <DataGridTextColumn Header="Số ký hiệu" Width="116" Binding="{Binding DocumentNumber}" ElementStyle="{StaticResource DenseGridMutedTextStyle}"/>
                        <DataGridTextColumn Header="Trích yếu" Width="*" Binding="{Binding Title}" ElementStyle="{StaticResource DenseDocumentTitleGridTextStyle}"/>
                        <DataGridTextColumn Header="Loại văn bản" Width="108" Binding="{Binding DocumentType}" ElementStyle="{StaticResource DenseGridMutedTextStyle}"/>
                        <DataGridTextColumn Header="Cơ quan ban hành" Width="150" Binding="{Binding SenderName}" ElementStyle="{StaticResource DenseGridMutedTextStyle}"/>
                        <DataGridTextColumn Header="Ngày ban hành" Width="112" Binding="{Binding IssueDate}" ElementStyle="{StaticResource DenseGridMutedTextStyle}"/>

                        <DataGridTemplateColumn Header="Trạng thái" Width="108">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DenseStatusBadgeStyle}"
                                            Background="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}">
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource DenseStatusBadgeTextStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Thao tác" Width="86">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource DenseTableActionsStackStyle}">
                                        <Button Style="{StaticResource DenseTableActionIconButtonStyle}" ToolTip="Xem">
                                            <materialDesign:PackIcon Kind="EyeOutline" Style="{StaticResource DenseTableActionIconStyle}"/>
                                        </Button>
                                        <Button Style="{StaticResource DenseTableActionIconButtonStyle}" ToolTip="Sửa">
                                            <materialDesign:PackIcon Kind="PencilOutline" Style="{StaticResource DenseTableActionIconStyle}"/>
                                        </Button>
                                        <Button Style="{StaticResource DenseTableActionIconButtonStyle}" ToolTip="Khác">
                                            <materialDesign:PackIcon Kind="DotsVertical" Style="{StaticResource DenseTableActionIconStyle}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource EmptyStateContainerStyle}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasDocuments}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Style="{StaticResource DenseCenteredStateStackStyle}">
                        <TextBlock Text="Chưa có dữ liệu" Style="{StaticResource DenseEmptyStateTitleTextStyle}"/>
                        <TextBlock Text="Không tìm thấy văn bản phù hợp với điều kiện hiện tại." Style="{StaticResource DenseEmptyStateDescriptionTextStyle}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Style="{StaticResource DenseDocumentFooterGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding TotalCount, StringFormat=Hiển thị dữ liệu trong tổng số {0} văn bản}"
                       Style="{StaticResource DenseFooterMutedTextStyle}"/>

            <StackPanel Grid.Column="1" Style="{StaticResource DensePagerStackStyle}">
                <Button Command="{Binding PreviousPageCommand}"
                        Style="{StaticResource DensePagerIconButtonStyle}"
                        IsEnabled="{Binding CanGoPrevious}">
                    <materialDesign:PackIcon Kind="ChevronLeft" Style="{StaticResource DenseShellChevronIconStyle}"/>
                </Button>

                <Border Style="{StaticResource DensePagerPillStyle}">
                    <TextBlock Text="{Binding PageDisplayText}" Style="{StaticResource DensePagerTextStyle}"/>
                </Border>

                <Button Command="{Binding NextPageCommand}"
                        Style="{StaticResource DensePagerIconButtonStyle}"
                        IsEnabled="{Binding CanGoNext}">
                    <materialDesign:PackIcon Kind="ChevronRight" Style="{StaticResource DenseShellChevronIconStyle}"/>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.RowSpan="3"
              Style="{StaticResource LoadingOverlayGridStyle}"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource LoadingCardStyle}">
                <StackPanel Style="{StaticResource DenseCenteredStateStackStyle}">
                    <ProgressBar Style="{StaticResource DenseLoadingProgressBarStyle}" IsIndeterminate="True"/>
                    <TextBlock Text="Đang tải dữ liệu..." Style="{StaticResource LoadingTextStyle}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
