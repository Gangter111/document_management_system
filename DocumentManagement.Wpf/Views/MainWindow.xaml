<Window x:Class="DocumentManagement.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DocumentManagement.Wpf.ViewModels"
        xmlns:views="clr-namespace:DocumentManagement.Wpf.Views"
        mc:Ignorable="d"
        Title="Phú Gia Group - Hệ thống Quản lý Văn bản"
        Height="820"
        Width="1360"
        MinHeight="720"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource FluentCanvasBrush}"
        TextElement.Foreground="{StaticResource FluentTextBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type vm:DocumentListViewModel}">
            <views:DocumentListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:OperationalReportsViewModel}">
            <Grid Background="{StaticResource FluentCanvasBrush}" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Báo cáo vận hành"
                           Style="{StaticResource FluentTitleTextStyle}"
                           FontSize="22"/>

                <UniformGrid Grid.Row="2" Columns="4">
                    <Border Style="{StaticResource AppCardStyle}" Margin="0,0,10,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Tổng văn bản" Style="{StaticResource FluentCaptionTextStyle}"/>
                            <TextBlock Text="{Binding TotalDocuments}" Style="{StaticResource FluentTitleTextStyle}" FontSize="24"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AppCardStyle}" Margin="0,0,10,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Đã ban hành" Style="{StaticResource FluentCaptionTextStyle}"/>
                            <TextBlock Text="{Binding IssuedDocuments}" Style="{StaticResource FluentTitleTextStyle}" FontSize="24"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AppCardStyle}" Margin="0,0,10,0" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Còn hiệu lực" Style="{StaticResource FluentCaptionTextStyle}"/>
                            <TextBlock Text="{Binding EffectiveDocuments}" Style="{StaticResource FluentTitleTextStyle}" FontSize="24"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AppCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Quá hạn" Style="{StaticResource FluentCaptionTextStyle}"/>
                            <TextBlock Text="{Binding ExpiredDocuments}" Style="{StaticResource FluentTitleTextStyle}" FontSize="24"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource AppCardStyle}" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Theo phòng ban" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding DepartmentIssuedChart}"
                                      Style="{StaticResource AppDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Phòng ban" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Value}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AppCardStyle}" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Theo tháng" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding MonthlyIssuedChart}"
                                      Style="{StaticResource AppDataGridStyle}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tháng" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Số lượng" Binding="{Binding Value}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LookupCatalogViewModel}">
            <Grid Background="{StaticResource FluentCanvasBrush}" Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Danh mục vận hành" Style="{StaticResource FluentTitleTextStyle}" FontSize="22"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource AppCardStyle}" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Loại văn bản" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding Categories}" Style="{StaticResource AppDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                                    <DataGridTextColumn Header="Tên danh mục" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource AppCardStyle}" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Trạng thái" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,10"/>
                            <DataGrid ItemsSource="{Binding Statuses}" Style="{StaticResource AppDataGridStyle}" AutoGenerateColumns="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                                    <DataGridTextColumn Header="Tên trạng thái" Binding="{Binding Name}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}">
            <Grid Background="{StaticResource FluentCanvasBrush}" Margin="18">
                <Border Style="{StaticResource AppCardStyle}" Padding="18" MaxWidth="720" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Hệ thống" Style="{StaticResource FluentTitleTextStyle}" FontSize="22"/>
                        <TextBlock Text="Thông tin vận hành hiện tại" Style="{StaticResource FluentMutedTextStyle}" Margin="0,4,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Người dùng" Style="{StaticResource FluentCaptionTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource FluentBodyTextStyle}"/>
                            <TextBlock Grid.Row="1" Text="Vai trò" Style="{StaticResource FluentCaptionTextStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RoleName}" Style="{StaticResource FluentBodyTextStyle}"/>
                            <TextBlock Grid.Row="2" Text="Phòng ban" Style="{StaticResource FluentCaptionTextStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DepartmentName}" Style="{StaticResource FluentBodyTextStyle}"/>
                            <TextBlock Grid.Row="3" Text="API server" Style="{StaticResource FluentCaptionTextStyle}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ApiBaseUrl}" Style="{StaticResource FluentBodyTextStyle}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                            <Button Content="Cấu hình máy chủ" Command="{Binding ServerSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="140" Height="34"/>
                            <Button Content="Backup" Command="{Binding BackupCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="92" Height="34" Margin="10,0,0,0"/>
                            <Button Content="Restore" Command="{Binding RestoreCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="92" Height="34" Margin="10,0,0,0"/>
                            <Button Content="Seed Demo Data" Command="{Binding SeedDemoDataCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="130" Height="34" Margin="10,0,0,0"/>
                            <Button Content="Clear Demo Data" Command="{Binding ClearDemoDataCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="130" Height="34" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <Grid Background="{StaticResource FluentCanvasBrush}">
                <Border Width="480"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource AppCardStyle}"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource FluentTitleTextStyle}"
                                   FontSize="22"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{Binding Description}"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource FluentMutedTextStyle}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource FluentCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource FluentSurfaceBrush}"
                BorderBrush="{StaticResource FluentBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="9,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="23"
                            Height="23"
                            Background="{StaticResource FluentSurfaceBrush}"
                            BorderBrush="{StaticResource FluentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius6}">
                        <TextBlock Text="PG"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource FluentBrandBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1"
                        Height="27"
                        Background="{StaticResource FluentChromeBrush}"
                        BorderBrush="{StaticResource FluentBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius6}"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                    <Grid Margin="8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify"
                                                 Style="{StaticResource ShellIconStyle}"/>
                        <TextBlock Grid.Column="1"
                                   Text="Command, queue, document..."
                                   Style="{StaticResource FluentMutedTextStyle}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Border Grid.Column="2"
                                Height="17"
                                Padding="5,0"
                                Background="{StaticResource FluentSurfaceBrush}"
                                BorderBrush="{StaticResource FluentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius4}"
                                VerticalAlignment="Center">
                            <TextBlock Text="Ctrl K"
                                       FontFamily="{StaticResource FluentMonoFontFamily}"
                                       FontSize="10"
                                       Foreground="{StaticResource FluentTextMutedBrush}"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock Grid.Column="2"
                           Text="Quiet operations console"
                           Margin="12,0"
                           Style="{StaticResource FluentMutedTextStyle}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentRoleName}"
                               Style="{StaticResource FluentMutedTextStyle}"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <Border Width="23"
                            Height="23"
                            Margin="8,0"
                            Background="#4B5563"
                            CornerRadius="12">
                        <TextBlock Text="NV"
                                   Foreground="White"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding CurrentDisplayName}"
                               Style="{StaticResource FluentBodyTextStyle}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               MaxWidth="160"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource FluentChromeBrush}"
                    BorderBrush="{StaticResource FluentBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="34"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BorderBrush="{StaticResource FluentBorderSoftBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="8,0">
                        <Grid>
                            <TextBlock Text="Navigation"
                                       Style="{StaticResource FluentCaptionTextStyle}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="5">
                            <TextBlock Text="Hôm nay"
                                       Style="{StaticResource FluentCaptionTextStyle}"
                                       Margin="7,8,0,4"/>

                            <Button Style="{StaticResource ShellSidebarPrimaryButtonStyle}"
                                    Command="{Binding ShowDashboardCommand}"
                                    Visibility="{Binding CanViewDashboard, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="HomeOutline" Style="{StaticResource ShellIconStyle}"/>
                                    <TextBlock Text="Tổng quan" Margin="7,0,0,0" Style="{StaticResource FluentBodyTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ShellSidebarButtonStyle}"
                                    Command="{Binding ShowDocumentListCommand}"
                                    Visibility="{Binding CanViewDocuments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Style="{StaticResource ShellIconStyle}"/>
                                    <TextBlock Text="Văn bản" Margin="7,0,0,0" Style="{StaticResource FluentBodyTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ShellSidebarButtonStyle}"
                                    Command="{Binding CreateDocumentCommand}"
                                    Visibility="{Binding CanCreateDocument, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PencilBoxOutline" Style="{StaticResource ShellIconStyle}"/>
                                    <TextBlock Text="Soạn thảo" Margin="7,0,0,0" Style="{StaticResource FluentBodyTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="Hệ thống"
                                       Style="{StaticResource FluentCaptionTextStyle}"
                                       Margin="7,12,0,4"/>

                            <Button Style="{StaticResource ShellSidebarButtonStyle}"
                                    Command="{Binding ShowArchiveCommand}"
                                    Visibility="{Binding CanViewArchive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArchiveOutline" Style="{StaticResource ShellIconStyle}"/>
                                    <TextBlock Text="Lưu trữ" Margin="7,0,0,0" Style="{StaticResource FluentBodyTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ShellSidebarButtonStyle}"
                                    Command="{Binding ShowReportsCommand}"
                                    Visibility="{Binding CanViewReports, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChartBar" Style="{StaticResource ShellIconStyle}"/>
                                    <TextBlock Text="Báo cáo" Margin="7,0,0,0" Style="{StaticResource FluentBodyTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ShellSidebarButtonStyle}"
                                    Command="{Binding ShowCategoriesCommand}"
                                    Visibility="{Binding CanViewCategories, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TagMultipleOutline" Style="{StaticResource ShellIconStyle}"/>
                                    <TextBlock Text="Danh mục" Margin="7,0,0,0" Style="{StaticResource FluentBodyTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ShellSidebarButtonStyle}"
                                    Command="{Binding ShowSettingsCommand}"
                                    Visibility="{Binding CanViewSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CogOutline" Style="{StaticResource ShellIconStyle}"/>
                                    <TextBlock Text="Hệ thống" Margin="7,0,0,0" Style="{StaticResource FluentBodyTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="Vận hành"
                                       Style="{StaticResource FluentCaptionTextStyle}"
                                       Margin="7,12,0,4"/>

                            <Button Style="{StaticResource ShellSidebarButtonStyle}"
                                    Command="{Binding BackupCommand}"
                                    Visibility="{Binding CanBackup, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseArrowUpOutline" Style="{StaticResource ShellIconStyle}"/>
                                    <TextBlock Text="Backup" Margin="7,0,0,0" Style="{StaticResource FluentBodyTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource ShellSidebarButtonStyle}"
                                    Command="{Binding RestoreCommand}"
                                    Visibility="{Binding CanRestore, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseRefreshOutline" Style="{StaticResource ShellIconStyle}"/>
                                    <TextBlock Text="Restore" Margin="7,0,0,0" Style="{StaticResource FluentBodyTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="2"
                            Style="{StaticResource ShellSidebarButtonStyle}"
                            Click="ExitButton_Click"
                            Margin="5,1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" Style="{StaticResource ShellIconStyle}"/>
                            <TextBlock Text="Thoát" Margin="7,0,0,0" Style="{StaticResource FluentBodyTextStyle}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentView}"
                            ClipToBounds="True"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
