<Window x:Class="DocumentManagement.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:DocumentManagement.Wpf.ViewModels"
        xmlns:views="clr-namespace:DocumentManagement.Wpf.Views"
        mc:Ignorable="d"
        Title="Phú Gia Group - Hệ thống Quản lý Văn bản"
        Height="820"
        Width="1360"
        MinHeight="760"
        MinWidth="1180"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DenseShellWindowStyle}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate DataType="{x:Type vm:DocumentListViewModel}">
            <views:DocumentListView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ArchiveViewModel}">
            <views:ArchiveView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CatalogViewModel}">
            <views:CatalogView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SystemViewModel}">
            <views:SystemView />
        </DataTemplate>

    </Window.Resources>

    <Grid Style="{StaticResource DenseShellRootGridStyle}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Style="{StaticResource DenseShellSidebarStyle}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Bottom"
                        Style="{StaticResource DenseShellExitButtonStyle}"
                        Click="ExitButton_Click">
                    <StackPanel Style="{StaticResource DenseShellNavRowStackStyle}">
                        <materialDesign:PackIcon Kind="Logout"
                                                 Style="{StaticResource DenseShellNavIconStyle}"/>
                        <TextBlock Text="Thoát"
                                   Style="{StaticResource DenseShellNavTextStyle}"/>
                    </StackPanel>
                </Button>

                <StackPanel DockPanel.Dock="Top">
                    <Border Style="{StaticResource DenseShellLogoRegionStyle}">
                        <Border Style="{StaticResource DenseShellLogoCardStyle}">
                            <Image Source="pack://application:,,,/Assets/Images/logo-tach.png"
                                   Style="{StaticResource DenseShellLogoImageStyle}"/>
                        </Border>
                    </Border>

                    <RadioButton Style="{StaticResource DenseShellSidebarItemStyle}"
                                 IsChecked="True"
                                 Command="{Binding ShowDashboardCommand}"
                                 Visibility="{Binding CanViewDashboard, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 GroupName="MenuMain">
                        <StackPanel Style="{StaticResource DenseShellNavRowStackStyle}">
                            <materialDesign:PackIcon Kind="HomeOutline" Style="{StaticResource DenseShellNavIconStyle}"/>
                            <TextBlock Text="Tổng quan" Style="{StaticResource DenseShellNavTextStyle}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DenseShellSidebarItemStyle}"
                                 Command="{Binding ShowDocumentListCommand}"
                                 Visibility="{Binding CanViewDocuments, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 GroupName="MenuMain">
                        <StackPanel Style="{StaticResource DenseShellNavRowStackStyle}">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Style="{StaticResource DenseShellNavIconStyle}"/>
                            <TextBlock Text="Văn bản" Style="{StaticResource DenseShellNavTextStyle}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DenseShellSidebarItemStyle}"
                                 Command="{Binding CreateDocumentCommand}"
                                 Visibility="{Binding CanCreateDocument, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 GroupName="MenuMain">
                        <StackPanel Style="{StaticResource DenseShellNavRowStackStyle}">
                            <materialDesign:PackIcon Kind="PencilBoxOutline" Style="{StaticResource DenseShellNavIconStyle}"/>
                            <TextBlock Text="Soạn thảo" Style="{StaticResource DenseShellNavTextStyle}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DenseShellSidebarItemStyle}"
                                 Command="{Binding ShowArchiveCommand}"
                                 Visibility="{Binding CanViewArchive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 GroupName="MenuMain">
                        <StackPanel Style="{StaticResource DenseShellNavRowStackStyle}">
                            <materialDesign:PackIcon Kind="ArchiveOutline" Style="{StaticResource DenseShellNavIconStyle}"/>
                            <TextBlock Text="Lưu trữ" Style="{StaticResource DenseShellNavTextStyle}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DenseShellSidebarItemStyle}"
                                 Command="{Binding ShowReportsCommand}"
                                 Visibility="{Binding CanViewReports, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 GroupName="MenuMain">
                        <StackPanel Style="{StaticResource DenseShellNavRowStackStyle}">
                            <materialDesign:PackIcon Kind="ChartBar" Style="{StaticResource DenseShellNavIconStyle}"/>
                            <TextBlock Text="Báo cáo" Style="{StaticResource DenseShellNavTextStyle}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DenseShellSidebarItemStyle}"
                                 Command="{Binding ShowCategoriesCommand}"
                                 Visibility="{Binding CanViewCategories, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 GroupName="MenuMain">
                        <StackPanel Style="{StaticResource DenseShellNavRowStackStyle}">
                            <materialDesign:PackIcon Kind="TagMultipleOutline" Style="{StaticResource DenseShellNavIconStyle}"/>
                            <TextBlock Text="Danh mục" Style="{StaticResource DenseShellNavTextStyle}"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource DenseShellSidebarItemStyle}"
                                 Visibility="{Binding CanViewSettings, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Command="{Binding ShowSettingsCommand}"
                                 GroupName="MenuMain">
                        <StackPanel Style="{StaticResource DenseShellNavRowStackStyle}">
                            <materialDesign:PackIcon Kind="CogOutline" Style="{StaticResource DenseShellNavIconStyle}"/>
                            <TextBlock Text="Hệ thống" Style="{StaticResource DenseShellNavTextStyle}"/>
                        </StackPanel>
                    </RadioButton>

                    <Separator Style="{StaticResource DenseShellSidebarSeparatorStyle}"/>

                    <Button Style="{StaticResource DenseShellSidebarActionButtonStyle}"
                            Command="{Binding BackupCommand}"
                            Visibility="{Binding CanBackup, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Style="{StaticResource DenseShellNavRowStackStyle}">
                            <materialDesign:PackIcon Kind="DatabaseArrowUpOutline" Style="{StaticResource DenseShellNavIconStyle}"/>
                            <TextBlock Text="Backup" Style="{StaticResource DenseShellNavTextStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource DenseShellSidebarActionButtonStyle}"
                            Command="{Binding RestoreCommand}"
                            Visibility="{Binding CanRestore, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Style="{StaticResource DenseShellNavRowStackStyle}">
                            <materialDesign:PackIcon Kind="DatabaseRefreshOutline" Style="{StaticResource DenseShellNavIconStyle}"/>
                            <TextBlock Text="Restore" Style="{StaticResource DenseShellNavTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1"
              Style="{StaticResource DenseShellMainGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource DenseShellTopBarStyle}">
                <Grid Style="{StaticResource DenseTopBarContentGridStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource DenseShellSearchBoxStyle}">
                        <Grid Style="{StaticResource DenseSearchContentGridStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="22"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DenseSearchTextBoxStyle}"
                                     materialDesign:HintAssist.Hint="Tìm kiếm văn bản, hồ sơ..."
                                     materialDesign:HintAssist.IsFloating="False"
                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                            <materialDesign:PackIcon Grid.Column="1"
                                                     Kind="Magnify"
                                                     Style="{StaticResource DenseShellSearchIconStyle}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Style="{StaticResource DenseShellUserRowStackStyle}">
                        <Button Style="{StaticResource DenseTopIconButtonStyle}" ToolTip="Thông báo">
                            <materialDesign:PackIcon Kind="BellOutline" Style="{StaticResource DenseShellTopIconStyle}"/>
                        </Button>

                        <Border Style="{StaticResource DenseShellAvatarStyle}">
                            <TextBlock Text="NV" Style="{StaticResource DenseShellAvatarTextStyle}"/>
                        </Border>

                        <StackPanel Style="{StaticResource DenseShellUserStackStyle}">
                            <TextBlock Text="{Binding CurrentDisplayName}"
                                       Style="{StaticResource DenseShellUserNameTextStyle}"/>
                            <TextBlock Text="{Binding CurrentDepartmentName}"
                                       Style="{StaticResource DenseShellUserMetaTextStyle}"/>
                        </StackPanel>

                        <materialDesign:PackIcon Kind="ChevronDown"
                                                 Style="{StaticResource DenseShellChevronIconStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentView}"
                            ClipToBounds="True"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>
