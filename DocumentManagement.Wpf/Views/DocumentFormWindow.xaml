<Window x:Class="DocumentManagement.Wpf.Views.DocumentFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin văn bản"
        Height="800"
        Width="980"
        MinHeight="720"
        MinWidth="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource DenseFormWindowStyle}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <Grid Style="{StaticResource DenseFormRootGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Style="{StaticResource DenseFormHeaderPanelStyle}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Thông tin văn bản"
                               Style="{StaticResource DenseFormTitleTextStyle}"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Style="{StaticResource DenseReadonlyBadgeStyle}"
                            Visibility="{Binding IsReadOnlyMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Chế độ xem"
                                   Style="{StaticResource DenseReadonlyBadgeTextStyle}"/>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Border Grid.Row="1"
                Style="{StaticResource DenseFormBodyPanelStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- UPLOAD -->
                <Border Grid.Row="0"
                        Style="{StaticResource DenseFormUploadPanelStyle}">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="File PDF:"
                                   Style="{StaticResource DenseFormUploadLabelTextStyle}"/>

                        <Button Grid.Column="1"
                                Content="Chọn file"
                                Style="{StaticResource DenseFormUploadSecondaryButtonStyle}"
                                Command="{Binding BrowseFileCommand}"
                                IsEnabled="{Binding CanBrowseFile}"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding SelectedFilePath}"
                                   Style="{StaticResource FileNameTextStyle}"/>

                        <Button Grid.Column="3"
                                Content="Tự động điền từ PDF"
                                Style="{StaticResource DenseFormPrimaryButtonStyle}"
                                Command="{Binding AutoFillCommand}"
                                IsEnabled="{Binding CanAutoFill}"/>
                    </Grid>
                </Border>

                <!-- FORM -->
                <ScrollViewer Grid.Row="1"
                              Style="{StaticResource DenseFormScrollViewerStyle}">

                    <Grid IsEnabled="{Binding CanModifyDocument}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Loại văn bản" Style="{StaticResource LabelStyle}"/>
                            <ComboBox SelectedValue="{Binding DocumentType}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource DenseFormComboBoxStyle}">
                                <ComboBoxItem Content="Văn bản đến" Tag="INCOMING"/>
                                <ComboBoxItem Content="Văn bản đi" Tag="OUTGOING"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Số hiệu văn bản (*)" Style="{StaticResource RequiredLabelStyle}"/>
                            <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DenseFormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource FormFieldPanelStyle}">
                            <TextBlock Text="Tiêu đề / Trích yếu văn bản (*)" Style="{StaticResource RequiredLabelStyle}"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DenseFormTitleInputTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Số ký hiệu / Số phụ" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ReferenceNumber}"
                                     Style="{StaticResource DenseFormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Danh mục văn bản" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedValue="{Binding CategoryId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource DenseFormComboBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Ngày ban hành" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding IssueDate}"
                                        Style="{StaticResource DenseFormDatePickerStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Trạng thái" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Statuses}"
                                      SelectedValue="{Binding StatusId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      IsEnabled="False"
                                      Style="{StaticResource DenseFormComboBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Ngày nhận" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding ReceivedDate}"
                                        Style="{StaticResource DenseFormDatePickerStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Hạn xử lý" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding DueDate}"
                                        Style="{StaticResource DenseFormDatePickerStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Cơ quan ban hành / Người gửi" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SenderName}"
                                     Style="{StaticResource DenseFormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Nơi nhận / Người nhận" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ReceiverName}"
                                     Style="{StaticResource DenseFormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Người ký" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SignerName}"
                                     Style="{StaticResource DenseFormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Phòng ban chủ trì" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ProcessingDepartment}"
                                     Style="{StaticResource DenseFormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="7"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Người được giao xử lý" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding AssignedTo}"
                                     Style="{StaticResource DenseFormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="7"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Độ mật" Style="{StaticResource LabelStyle}"/>
                            <ComboBox SelectedValue="{Binding ConfidentialityLevel}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource DenseFormComboBoxStyle}">
                                <ComboBoxItem Content="Bình thường" Tag="NORMAL"/>
                                <ComboBoxItem Content="Mật" Tag="CONFIDENTIAL"/>
                                <ComboBoxItem Content="Tối mật" Tag="SECRET"/>
                                <ComboBoxItem Content="Tuyệt mật" Tag="TOP_SECRET"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="8"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Độ khẩn" Style="{StaticResource LabelStyle}"/>
                            <ComboBox SelectedValue="{Binding UrgencyLevel}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource DenseFormComboBoxStyle}">
                                <ComboBoxItem Content="Bình thường" Tag="NORMAL"/>
                                <ComboBoxItem Content="Khẩn" Tag="URGENT"/>
                                <ComboBoxItem Content="Hỏa tốc" Tag="VERY_URGENT"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="8"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Ghi chú" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Notes}"
                                     Style="{StaticResource DenseFormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="9"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource FormFieldPanelStyle}">
                            <TextBlock Text="Trích yếu nội dung" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Summary}"
                                     Height="84"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Style="{StaticResource DenseFormMultilineTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="10"
                                    Grid.ColumnSpan="2">
                            <TextBlock Text="Nội dung văn bản"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ContentText}"
                                     Height="150"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource DenseFormMultilineTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Style="{StaticResource DenseFormFooterStyle}">

            <DockPanel LastChildFill="False">

                <Button Content="Xóa văn bản"
                        DockPanel.Dock="Left"
                        Style="{StaticResource DenseFormDangerButtonStyle}"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">

                    <Button
                            IsCancel="True"
                            >
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DenseFormCancelButtonStyle}">
                                <Setter Property="Content" Value="Hủy bỏ"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnlyMode}" Value="True">
                                        <Setter Property="Content" Value="Đóng"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Lưu văn bản"
                            Style="{StaticResource DenseFormPrimaryButtonStyle}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSaveDocument}"
                            Visibility="{Binding CanSaveDocument, Converter={StaticResource BoolToVisibility}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
