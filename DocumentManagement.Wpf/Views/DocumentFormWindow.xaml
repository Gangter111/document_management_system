<Window x:Class="DocumentManagement.Wpf.Views.DocumentFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thông tin văn bản"
        Height="800"
        Width="980"
        MinHeight="720"
        MinWidth="920"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource FluentCanvasBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeBody}"
        KeyboardNavigation.TabNavigation="Cycle"
        KeyboardNavigation.ControlTabNavigation="Cycle">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <SolidColorBrush x:Key="FormReadonlyBadgeBackgroundBrush" Color="#FFF7ED"/>
        <SolidColorBrush x:Key="FormReadonlyBadgeBorderBrush" Color="#FDBA74"/>
        <SolidColorBrush x:Key="FormReadonlyBadgeTextBrush" Color="#9A3412"/>
        <SolidColorBrush x:Key="ExtractionInfoBackgroundBrush" Color="#EFF6FF"/>
        <SolidColorBrush x:Key="ExtractionInfoBorderBrush" Color="#BFDBFE"/>
        <SolidColorBrush x:Key="ExtractionInfoTextBrush" Color="#1E3A8A"/>
        <SolidColorBrush x:Key="ExtractionWarningBackgroundBrush" Color="#FFFBEB"/>
        <SolidColorBrush x:Key="ExtractionWarningBorderBrush" Color="#FDE68A"/>
        <SolidColorBrush x:Key="ExtractionWarningTextBrush" Color="#92400E"/>
        <SolidColorBrush x:Key="ExtractionErrorBackgroundBrush" Color="#FEF2F2"/>
        <SolidColorBrush x:Key="ExtractionErrorBorderBrush" Color="#FECACA"/>
        <SolidColorBrush x:Key="ExtractionErrorTextBrush" Color="#991B1B"/>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="{StaticResource FluentTextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        </Style>

        <Style x:Key="RequiredLabelStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource LabelStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="FormFieldPanelStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LeftFormFieldPanelStyle"
               TargetType="StackPanel"
               BasedOn="{StaticResource FormFieldPanelStyle}">
            <Setter Property="Margin" Value="0,0,10,12"/>
        </Style>

        <Style x:Key="RightFormFieldPanelStyle"
               TargetType="StackPanel"
               BasedOn="{StaticResource FormFieldPanelStyle}">
            <Setter Property="Margin" Value="10,0,0,12"/>
        </Style>

        <Style x:Key="ReadonlyBadgeStyle"
               TargetType="Border"
               BasedOn="{StaticResource FluentBadgeBorderStyle}">
            <Setter Property="Background" Value="{StaticResource FormReadonlyBadgeBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FormReadonlyBadgeBorderBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderBrush}"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource FluentDangerBrush}"/>
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderStrongBrush}"/>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderBrush}"/>
        </Style>

        <Style x:Key="FormDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource AppDatePickerStyle}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource FluentBorderBrush}"/>
        </Style>

        <Style x:Key="OcrReviewTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource FormTextBoxStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ExtractionWarningBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ExtractionWarningBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OcrReviewDatePickerStyle" TargetType="DatePicker" BasedOn="{StaticResource FormDatePickerStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{StaticResource ExtractionWarningBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ExtractionWarningBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FileNameTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="MaxWidth" Value="360"/>
            <Setter Property="Foreground" Value="{StaticResource FluentTextMutedBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        </Style>

        <Style x:Key="ExtractionMessageBorderStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{StaticResource ExtractionInfoBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ExtractionInfoBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource Radius4}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExtractionMessageKind}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource ExtractionWarningBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ExtractionWarningBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExtractionMessageKind}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource ExtractionErrorBackgroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ExtractionErrorBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExtractionMessageTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{StaticResource ExtractionInfoTextBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="LineHeight" Value="19"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ExtractionMessageKind}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource ExtractionWarningTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ExtractionMessageKind}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource ExtractionErrorTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FormSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource FluentCaptionTextStyle}">
            <Setter Property="Margin" Value="0,2,0,8"/>
            <Setter Property="Padding" Value="0,6,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource FluentTextMutedBrush}"/>
        </Style>

        <Style x:Key="FormFooterButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource FluentSurfaceBrush}"
                BorderBrush="{StaticResource FluentBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Thông tin văn bản"
                               Style="{StaticResource FluentTitleTextStyle}"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Style="{StaticResource ReadonlyBadgeStyle}"
                            Visibility="{Binding IsReadOnlyMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Chế độ xem"
                                   Foreground="{StaticResource FormReadonlyBadgeTextBrush}"
                                   Style="{StaticResource FluentBadgeTextStyle}"/>
                    </Border>

                </StackPanel>
            </Grid>
        </Border>

        <!-- BODY -->
        <Border Grid.Row="1"
                Background="{StaticResource FluentCanvasBrush}"
                Padding="14,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- UPLOAD -->
                <Border Grid.Row="0"
                        Background="{StaticResource FluentSurfaceBrush}"
                        BorderBrush="{StaticResource FluentBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius6}"
                        Padding="10"
                        Margin="0,0,0,10">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="File PDF:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource FluentTextBrush}"/>

                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Content="Chọn file"
                                MinWidth="92"
                                Style="{StaticResource CompactCommandButtonStyle}"
                                Command="{Binding BrowseFileCommand}"
                                IsEnabled="{Binding CanBrowseFile}"
                                Margin="0,0,12,0"/>

                        <Border Grid.Row="0"
                                Grid.Column="2"
                                Background="{StaticResource FluentSurfaceMutedBrush}"
                                BorderBrush="{StaticResource FluentBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius4}"
                                Padding="8,0"
                                MinHeight="28"
                                Margin="0,0,12,0">
                            <TextBlock Text="{Binding SelectedFilePath}"
                                       ToolTip="{Binding SelectedFilePath}"
                                       Style="{StaticResource FileNameTextStyle}"/>
                        </Border>

                        <Button Grid.Row="0"
                                Grid.Column="3"
                                Content="Trích xuất văn bản PDF"
                                MinWidth="166"
                                Style="{StaticResource CompactPrimaryButtonStyle}"
                                Command="{Binding AutoFillCommand}"
                                IsEnabled="{Binding CanAutoFill}"
                                ToolTip="Trích xuất văn bản từ PDF có lớp chữ. PDF scan ảnh cần nhập thủ công."/>
                        <Border Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource ExtractionMessageBorderStyle}"
                                Visibility="{Binding HasExtractionMessage, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding ExtractionMessage}"
                                       HorizontalAlignment="Stretch"
                                       Style="{StaticResource ExtractionMessageTextStyle}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- FORM -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,6,0">

                    <StackPanel IsEnabled="{Binding CanModifyDocument}">
                        <TextBlock Text="THÔNG TIN NGHIỆP VỤ"
                                   Style="{StaticResource FormSectionTitleStyle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Loại văn bản" Style="{StaticResource LabelStyle}"/>
                            <ComboBox SelectedValue="{Binding DocumentType}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource FormComboBoxStyle}">
                                <ComboBoxItem Content="Văn bản đến" Tag="INCOMING"/>
                                <ComboBoxItem Content="Văn bản đi" Tag="OUTGOING"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Số hiệu văn bản (*)" Style="{StaticResource RequiredLabelStyle}"/>
                            <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{Binding DocumentNumberNeedsReview}"
                                     ToolTip="{Binding DocumentNumberExtractionSource}"
                                     Style="{StaticResource OcrReviewTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource FormFieldPanelStyle}">
                            <TextBlock Text="Tiêu đề / Trích yếu văn bản (*)" Style="{StaticResource RequiredLabelStyle}"/>
                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontWeight="SemiBold"
                                     Tag="{Binding TitleNeedsReview}"
                                     ToolTip="{Binding TitleExtractionSource}"
                                     Style="{StaticResource OcrReviewTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Số ký hiệu / Số phụ" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ReferenceNumber}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Danh mục văn bản" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedValue="{Binding CategoryId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Ngày ban hành" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding IssueDate}"
                                        Tag="{Binding IssueDateNeedsReview}"
                                        ToolTip="{Binding IssueDateExtractionSource}"
                                        Style="{StaticResource OcrReviewDatePickerStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Trạng thái" Style="{StaticResource LabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Statuses}"
                                      SelectedValue="{Binding StatusId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      IsEnabled="False"
                                      Style="{StaticResource FormComboBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Ngày nhận" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding ReceivedDate}"
                                        Style="{StaticResource FormDatePickerStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Hạn xử lý" Style="{StaticResource LabelStyle}"/>
                            <DatePicker SelectedDate="{Binding DueDate}"
                                        Style="{StaticResource FormDatePickerStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Cơ quan ban hành / Người gửi" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SenderName}"
                                     Tag="{Binding SenderNameNeedsReview}"
                                     ToolTip="{Binding SenderNameExtractionSource}"
                                     Style="{StaticResource OcrReviewTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Nơi nhận / Người nhận" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ReceiverName}"
                                     Tag="{Binding ReceiverNameNeedsReview}"
                                     ToolTip="{Binding ReceiverNameExtractionSource}"
                                     Style="{StaticResource OcrReviewTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Người ký" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding SignerName}"
                                     Tag="{Binding SignerNameNeedsReview}"
                                     ToolTip="{Binding SignerNameExtractionSource}"
                                     Style="{StaticResource OcrReviewTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Phòng ban chủ trì" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ProcessingDepartment}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="7"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Người được giao xử lý" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding AssignedTo}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="7"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Độ mật" Style="{StaticResource LabelStyle}"/>
                            <ComboBox SelectedValue="{Binding ConfidentialityLevel}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource FormComboBoxStyle}">
                                <ComboBoxItem Content="Bình thường" Tag="NORMAL"/>
                                <ComboBoxItem Content="Mật" Tag="CONFIDENTIAL"/>
                                <ComboBoxItem Content="Tối mật" Tag="SECRET"/>
                                <ComboBoxItem Content="Tuyệt mật" Tag="TOP_SECRET"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="8"
                                    Grid.Column="0"
                                    Style="{StaticResource LeftFormFieldPanelStyle}">
                            <TextBlock Text="Độ khẩn" Style="{StaticResource LabelStyle}"/>
                            <ComboBox SelectedValue="{Binding UrgencyLevel}"
                                      SelectedValuePath="Tag"
                                      Style="{StaticResource FormComboBoxStyle}">
                                <ComboBoxItem Content="Bình thường" Tag="NORMAL"/>
                                <ComboBoxItem Content="Khẩn" Tag="URGENT"/>
                                <ComboBoxItem Content="Hỏa tốc" Tag="VERY_URGENT"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="8"
                                    Grid.Column="1"
                                    Style="{StaticResource RightFormFieldPanelStyle}">
                            <TextBlock Text="Ghi chú" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Notes}"
                                     Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <Border Grid.Row="9"
                                Grid.ColumnSpan="2"
                                BorderBrush="{StaticResource FluentBorderBrush}"
                                BorderThickness="0,1,0,0"
                                Margin="0,4,0,8">
                            <TextBlock Text="NỘI DUNG VĂN BẢN"
                                       Style="{StaticResource FormSectionTitleStyle}"/>
                        </Border>

                        <StackPanel Grid.Row="10"
                                    Grid.ColumnSpan="2"
                                    Style="{StaticResource FormFieldPanelStyle}">
                            <TextBlock Text="Trích yếu nội dung" Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding Summary}"
                                     Height="84"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Style="{StaticResource FormMultilineTextBoxStyle}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="11"
                                    Grid.ColumnSpan="2">
                            <TextBlock Text="Nội dung văn bản"
                                       Style="{StaticResource LabelStyle}"/>
                            <TextBox Text="{Binding ContentText}"
                                     Height="150"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource FormMultilineTextBoxStyle}"/>
                        </StackPanel>
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Border Grid.Row="2"
                Background="{StaticResource FluentSurfaceBrush}"
                Padding="14,9"
                BorderBrush="{StaticResource FluentBorderBrush}"
                BorderThickness="0,1,0,0"
                Margin="0">

            <DockPanel LastChildFill="False">

                <Button Content="Xóa văn bản"
                        DockPanel.Dock="Left"
                        MinWidth="118"
                        Height="32"
                        Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DeleteCommand}"
                        IsEnabled="{Binding CanDelete}"
                        Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">

                    <Button MinWidth="92"
                            Height="32"
                            IsCancel="True"
                            ToolTip="Esc"
                            Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FormFooterButtonStyle}">
                                <Setter Property="Content" Value="Hủy bỏ"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsReadOnlyMode}" Value="True">
                                        <Setter Property="Content" Value="Đóng"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Lưu văn bản"
                            MinWidth="138"
                            Height="32"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SaveCommand}"
                            IsDefault="True"
                            ToolTip="Enter"
                            IsEnabled="{Binding CanSaveDocument}"
                            Visibility="{Binding CanSaveDocument, Converter={StaticResource BoolToVisibility}}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
