        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource DenseSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DenseBorderBrush}"/>
    </Style>

    <Style x:Key="DenseFormMultilineTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DenseFormTextBoxStyle}">
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
    </Style>

    <Style x:Key="DenseFormTitleInputTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DenseFormTextBoxStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="DenseFormScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Padding" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="DenseDialogWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource DenseTextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="DenseDialogRootCardStyle" TargetType="Border" BasedOn="{StaticResource DenseCardStyle}">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="DenseDialogHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="BorderBrush" Value="{StaticResource DenseBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style x:Key="DenseDialogIconBackgroundStyle" TargetType="Border">
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="CornerRadius" Value="17"/>
        <Setter Property="Background" Value="{StaticResource DenseWarningSoftBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DenseDialogIconTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DenseWarningTextBrush}"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DenseDialogTitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DenseTextBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="DenseDialogSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DenseMutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="DenseDialogCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource DenseIconButtonStyle}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <Style x:Key="DenseDialogBodyStyle" TargetType="Border">
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="DenseDialogTitleStackStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="12,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DenseDialogMessageTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource DenseTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="DenseDialogFooterStyle" TargetType="Border">
        <Setter Property="Padding" Value="16,0,16,16"/>
    </Style>

    <Style x:Key="DenseDialogCancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DenseFormSecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="104"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="DenseDialogConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource DenseFormPrimaryButtonStyle}">
        <Setter Property="MinWidth" Value="124"/>
    </Style>

</ResourceDictionary>
