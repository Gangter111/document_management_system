<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="AppCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius8}"/>
        <Setter Property="Padding" Value="{StaticResource Inset16}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="FluentPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius6}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="SoftCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
        <Setter Property="Background" Value="{StaticResource FluentSurfaceMutedBrush}"/>
    </Style>

    <Style x:Key="HoverCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource FluentBorderStrongBrush}"/>
                <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FluentCommandBarStyle" TargetType="Border">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="{StaticResource FluentSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FluentBorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>

</ResourceDictionary>
