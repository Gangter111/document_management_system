{
  "Database": {
    "Provider": "Sqlite",
    "Path": "database/staging-app.db",
    "ConnectionString": "Server=localhost\\SQLEXPRESS;Database=DocumentManagementStagingDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "DocumentManagement",
    "Audience": "DocumentManagementClient",
    "Secret": "CHANGE_THIS_TO_A_LONG_SECURE_SECRET_KEY_32_CHARS_MIN_2026",
    "AccessTokenMinutes": 60
  },
  "Backup": {
    "AllowApiRestore": false
  },
  "Security": {
    "LoginRateLimit": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5034"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
